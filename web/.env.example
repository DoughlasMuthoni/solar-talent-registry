# Copy to .env (local) and set the same names in Vercel → Project → Settings → Environment Variables.
# Supabase → Project → Connect → ORMs / "Connection string".

# Runtime connections from the app (Vercel): Transaction pooler, port 6543.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations (prisma migrate): Session pooler or direct connection, port 5432.
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?connect_timeout=30"
# Only needed for a local Postgres without CREATE DATABASE rights; leave unset on Supabase.
# SHADOW_DATABASE_URL=""

# Supabase Auth (Phase 3) — Project Settings → API. The anon/publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-or-publishable-key>"
# Server only. NEVER prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="<service-role-or-secret-key>"

# Public base URL, used for social share links and emails.
NEXT_PUBLIC_SITE_URL="https://<your-domain>"

# Phase 4 — candidate status links + daily cron (generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
STATUS_LINK_SECRET="<32+ random chars>"
CRON_SECRET="<32+ random chars>"          # Vercel Cron sends it as a Bearer token
# Email via Brevo (transactional API). Without these, emails are logged as SKIPPED.
BREVO_API_KEY="<brevo api key>"
EMAIL_FROM_ADDRESS="careers@<your-verified-domain>"
EMAIL_FROM_NAME="Waterlift Solar Careers"
# EMAIL_REPLY_TO="hr@<your-domain>"
